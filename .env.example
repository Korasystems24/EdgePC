# Идентификация устройства и режимы работы
BUNKER_ID=bunker-001
DEBUG=true
RADAR_SOURCE=wcf
NETWORK_GATEWAY=mock

# Хранилище. Compose монтирует ./data в /app/data.
DB__NAME=telemetry.db
DB__DIR=data

# Файловые логи и zip-архивы ротации. Compose монтирует ./logs в /app/logs.
LOG__DIR=logs
LOG__FILE=prod.log

# Радар. Из контейнера LIMACO обычно доступен как host.docker.internal.
WCF__WSDL_URL=http://localhost:8001/service?wsdl
WCF__TIMEOUT=3
# Хост вместо localhost/127.0.0.1 из schemaLocation и soap:address.
# Compose задаёт host.docker.internal; на хосте без контейнера оставьте пустым.
WCF__LOOPBACK_ALIAS=

# Сбор телеметрии
INGESTION__INTERVAL=5.0
INGESTION__TICK_DEADLINE=20.0
INGESTION__MIN_FREE_MB=200
INGESTION__RESUME_FREE_MB=250

# Отправка. server_url и auth_token обязательны при NETWORK_GATEWAY=http.
DISPATCH__INTERVAL=10.0
# 50 пакетов — это ~250 КиБ тела запроса; 200 дают мегабайт и упираются в
# дефолтный client_max_body_size у nginx.
DISPATCH__BATCH_SIZE=50
DISPATCH__EVENT_BATCH_SIZE=50
DISPATCH__HTTP__SERVER_URL=
DISPATCH__HTTP__AUTH_TOKEN=
DISPATCH__QUARANTINE_AFTER_ATTEMPTS=3
# Выборка 422-изоляции должна успевать пройти целиком за бюджет изоляции.
DISPATCH__MASS_REJECTION_SAMPLE=4

# Надзор и остановка
HEARTBEAT_MAX_SILENCE=60.0
SHUTDOWN_TIMEOUT=8.0
RESTART_JOIN_TIMEOUT=5.0
WATCHDOG__INTERVAL=5.0
WATCHDOG__INSPECT_TIMEOUT=10.0

# Страж event loop: порог должен покрывать разбор WSDL на первом тике.
GUARD__THRESHOLD=15.0
GUARD__CHECK_INTERVAL=1.0

# Mock-режимы: доли сбоев независимы друг от друга.
MOCK_RADAR__FAIL_RATE=0.05
MOCK_RADAR__DELAY=1.0
MOCK_GATEWAY__FAIL_RATE=0.5
MOCK_GATEWAY__DELAY=1.0
